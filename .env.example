# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/just_mobile_development?retryWrites=true&w=majority

# OpenAI API Key for Bele AI Chatbot
OPENAI_KEY=sk-proj-your_openai_key_here

# Backend Server Port
PORT=3001

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# SMTP Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM="JustMobile AU" <your_email@domain.com>
