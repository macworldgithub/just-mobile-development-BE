# -----------------------------------------------------------------------------
# JUSTMOBILE BACKEND ENVIRONMENT VARIABLES (.env.example)
# Add these variables to your Vercel Project Settings -> Environment Variables
# -----------------------------------------------------------------------------

# Application Environment
NODE_ENV=production
PORT=3001

# Frontend Origin URL (Optional - CORS allows .vercel.app and localhost automatically)
FRONTEND_URL=https://justmobile.vercel.app

# JWT Secret for Session & Customer Token Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# MongoDB Connection URI (Atlas Cluster)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# OpenAI API Key (Bele AI Chatbot Assistant)
OPENAI_KEY=sk-proj-...

# Optional: xAI API Key (Alternative Model Support)
XAI_API_KEY=

# -----------------------------------------------------------------------------
# TELCOINABOX / OCTANE & BENZINE CARRIER INTEGRATION
# -----------------------------------------------------------------------------
apiBaseUrl=https://octane.telcoinabox.com/api/v1
octaneUserName=
octanePassword=
benzineBaseUrl=https://secure.telcoinabox.com/benzine
benzineUserName=
benzinePassword=
groupNo=922
quickstreamApiKey=

# Safety Guard Switch: 'false' for mock provisioning, 'true' for real SIM activation
TELCO_LIVE_CREATE=false

# -----------------------------------------------------------------------------
# EMAIL SERVICES (Hostinger SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@justmobile.com.au
SMTP_PASS=
SMTP_FROM=no-reply@justmobile.com.au
